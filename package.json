{
  "name": "errbuster",
  "version": "0.1.0",
  "description": "A multi-language CLI for parsing and presenting runtime, compiler, and process errors in a clean, readable format.",
  "type": "module",
  "author": "Sabha Mushtaq",
  "license": "MIT",

  "files": [
    "dist"
  ],

  "bin": {
    
    "errbuster": "./dist/cli/index.js"
  },

  "engines": {
    "node": ">=20"
  },

  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },

  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}